<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <bpmn:process id="application-orchestration" name="Application Orchestration" isExecutable="true" camunda:historyTimeToLive="180">

    
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_1" targetRef="Task_InitializeApp" />

    
    <bpmn:serviceTask id="Task_InitializeApp" name="Initialize Application" camunda:delegateExpression="${initializeApplicationWorker}">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Initialize</bpmn:outgoing>
    </bpmn:serviceTask>

    
    <bpmn:boundaryEvent id="BoundaryEvent_InitApp" name="App Fetch Error" attachedToRef="Task_InitializeApp">
      <bpmn:outgoing>Flow_InitApp_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_InitApp" errorRef="Error_AppFetchFailed" />
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_InitApp_Error" sourceRef="BoundaryEvent_InitApp" targetRef="Task_HandleFailure" />

    <bpmn:sequenceFlow id="Flow_Initialize" sourceRef="Task_InitializeApp" targetRef="Task_VerifyConsent" />

    
    <bpmn:serviceTask id="Task_VerifyConsent" name="Verify Consent" camunda:delegateExpression="${verifyConsentWorker}">
      <bpmn:incoming>Flow_Initialize</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify</bpmn:outgoing>
    </bpmn:serviceTask>

    
    <bpmn:boundaryEvent id="BoundaryEvent_Consent" name="Unsupported Service Code" attachedToRef="Task_VerifyConsent">
      <bpmn:outgoing>Flow_Consent_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Consent" errorRef="Error_UnsupportedServiceCode" />
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_Consent_Error" sourceRef="BoundaryEvent_Consent" targetRef="Task_HandleFailure" />

    <bpmn:sequenceFlow id="Flow_Verify" sourceRef="Task_VerifyConsent" targetRef="Gateway_Consent" />

    
    <bpmn:exclusiveGateway id="Gateway_Consent" name="Consent Valid?">
      <bpmn:incoming>Flow_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Consent_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Consent_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    
    <bpmn:sequenceFlow id="Flow_Consent_Yes" name="Yes" sourceRef="Gateway_Consent" targetRef="Task_FetchInterop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consentValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_FetchInterop" name="Fetch Interoperability Data" camunda:delegateExpression="${interoperabilityWorker}">
      <bpmn:incoming>Flow_Consent_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Interop</bpmn:outgoing>
    </bpmn:serviceTask>

    
    <bpmn:boundaryEvent id="BoundaryEvent_Interop" name="Interop Fetch Error" attachedToRef="Task_FetchInterop">
      <bpmn:outgoing>Flow_Interop_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Interop" errorRef="Error_InteropFetchFailed" />
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_Interop_Error" sourceRef="BoundaryEvent_Interop" targetRef="Task_HandleFailure" />

    <bpmn:sequenceFlow id="Flow_Interop" sourceRef="Task_FetchInterop" targetRef="Task_VerifyData" />

    
    <bpmn:serviceTask id="Task_VerifyData" name="Verify Data" camunda:delegateExpression="${verifyDataWorker}"><bpmn:incoming>Flow_Interop</bpmn:incoming><bpmn:outgoing>Flow_Verify</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="Flow_VerifyData_To_PendingReview" sourceRef="Task_VerifyData" targetRef="Task_SetPendingReview" /><bpmn:serviceTask id="Task_SetPendingReview" name="Set Pending Officer Review" camunda:expression="${execution.setVariable('workflowStatus', 'PENDING_OFFICER_REVIEW')}">
      <bpmn:incoming>Flow_VerifyData_To_PendingReview</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CallbackPending</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_To_CallbackPending" sourceRef="Task_SetPendingReview" targetRef="Task_CallbackPendingReview" />

    <bpmn:serviceTask id="Task_CallbackPendingReview" name="Callback Pending Review" camunda:delegateExpression="${statusCallbackWorker}">
      <bpmn:incoming>Flow_To_CallbackPending</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OfficerReview</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_To_OfficerReview" sourceRef="Task_CallbackPendingReview" targetRef="UserTask_OfficerReview" />

    
    <bpmn:userTask id="UserTask_OfficerReview" name="Officer Review" camunda:candidateGroups="OFFICER">
      <bpmn:incoming>Flow_To_OfficerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_To_DecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_To_DecisionGateway" sourceRef="UserTask_OfficerReview" targetRef="Gateway_OfficerDecision" />

    
    <bpmn:exclusiveGateway id="Gateway_OfficerDecision" name="Officer Decision?">
      <bpmn:incoming>Flow_To_DecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    
    <bpmn:sequenceFlow id="Flow_Decision_Approve" name="Approve" sourceRef="Gateway_OfficerDecision" targetRef="Task_SetApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${officerDecision == 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_SetApproved" name="Set Status Approved" camunda:expression="${execution.setVariable('workflowStatus', 'APPROVED')}">
      <bpmn:incoming>Flow_Decision_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CallbackApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_To_CallbackApproved" sourceRef="Task_SetApproved" targetRef="Task_CallbackApproved" />

    <bpmn:serviceTask id="Task_CallbackApproved" name="Callback Approved" camunda:delegateExpression="${statusCallbackWorker}">
      <bpmn:incoming>Flow_To_CallbackApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Task_CallbackApproved" targetRef="EndEvent_Approved" />

    <bpmn:endEvent id="EndEvent_Approved" name="Approved">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    
    <bpmn:sequenceFlow id="Flow_Decision_Reject" name="Reject" sourceRef="Gateway_OfficerDecision" targetRef="Task_SetRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${officerDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_SetRejected" name="Set Status Rejected" camunda:expression="${execution.setVariable('workflowStatus', 'REJECTED')}">
      <bpmn:incoming>Flow_Decision_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CallbackRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_To_CallbackRejected" sourceRef="Task_SetRejected" targetRef="Task_CallbackRejected" />

    <bpmn:serviceTask id="Task_CallbackRejected" name="Callback Rejected" camunda:delegateExpression="${statusCallbackWorker}">
      <bpmn:incoming>Flow_To_CallbackRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Task_CallbackRejected" targetRef="EndEvent_Rejected" />

    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    
    <bpmn:sequenceFlow id="Flow_Consent_No" name="No" sourceRef="Gateway_Consent" targetRef="Task_SetConsentDenied">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consentValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_SetConsentDenied" name="Set Consent Denied" camunda:expression="${execution.setVariable('workflowStatus', 'CONSENT_DENIED')}">
      <bpmn:incoming>Flow_Consent_No</bpmn:incoming>
      <bpmn:outgoing>Flow_DeniedCallback</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_DeniedCallback" sourceRef="Task_SetConsentDenied" targetRef="Task_CallbackDenied" />

    <bpmn:serviceTask id="Task_CallbackDenied" name="Callback Consent Denied" camunda:delegateExpression="${statusCallbackWorker}">
      <bpmn:incoming>Flow_DeniedCallback</bpmn:incoming>
      <bpmn:outgoing>Flow_Denied</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Denied" sourceRef="Task_CallbackDenied" targetRef="EndEvent_Denied" />

    <bpmn:endEvent id="EndEvent_Denied" name="Consent Denied">
      <bpmn:incoming>Flow_Denied</bpmn:incoming>
    </bpmn:endEvent>

    
    <bpmn:serviceTask id="Task_HandleFailure" name="Handle Workflow Failure" camunda:expression="${execution.setVariable('workflowStatus', 'FAILED')}">
      <bpmn:incoming>Flow_InitApp_Error</bpmn:incoming>
      <bpmn:incoming>Flow_Consent_Error</bpmn:incoming>
      <bpmn:incoming>Flow_Interop_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_FailureCallback</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_FailureCallback" sourceRef="Task_HandleFailure" targetRef="Task_CallbackFailure" />

    <bpmn:serviceTask id="Task_CallbackFailure" name="Callback Failure" camunda:delegateExpression="${statusCallbackWorker}">
      <bpmn:incoming>Flow_FailureCallback</bpmn:incoming>
      <bpmn:outgoing>Flow_Failed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Failed" sourceRef="Task_CallbackFailure" targetRef="EndEvent_Failed" />

    <bpmn:endEvent id="EndEvent_Failed" name="Workflow Failed">
      <bpmn:incoming>Flow_Failed</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  
  <bpmn:error id="Error_AppFetchFailed" name="Application Fetch Failed" errorCode="APPLICATION_FETCH_FAILED" />
  <bpmn:error id="Error_InteropFetchFailed" name="Interop Fetch Failed" errorCode="INTEROP_FETCH_FAILED" />
  <bpmn:error id="Error_UnsupportedServiceCode" name="Unsupported Service Code" errorCode="UNSUPPORTED_SERVICE_CODE" />

</bpmn:definitions>